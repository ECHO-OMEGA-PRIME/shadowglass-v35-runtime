[Unit]
Description=ShadowGlass v7 Command bounded scheduler tick
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=forge
Group=forge
WorkingDirectory=/opt/shadowglass-v7-command
BindReadOnlyPaths=/home/forge/shadowglass-v7-command/current:/opt/shadowglass-v7-command:rbind
Environment=PYTHONUNBUFFERED=1
Environment=SERVICE_VERSION=release
Environment=SHADOWGLASS_COMMAND_CREDENTIAL_DIR=/etc/echo/credentials/shadowglass-v7-command
LoadCredential=database-url:/etc/echo/credentials/shadowglass-v7-command/database-url
LoadCredential=command-key:/etc/echo/credentials/shadowglass-v7-command/command-key
LoadCredential=cors-origins:/etc/echo/credentials/shadowglass-v7-command/cors-origins
LoadCredential=cloudflare-account-id:/etc/echo/credentials/shadowglass-v7-command/cloudflare-account-id
LoadCredential=cloudflare-queue-token:/etc/echo/credentials/shadowglass-v7-command/cloudflare-queue-token
LoadCredential=ps-queue-id:/etc/echo/credentials/shadowglass-v7-command/ps-queue-id
LoadCredential=tf-queue-id:/etc/echo/credentials/shadowglass-v7-command/tf-queue-id
LoadCredential=tyler-queue-id:/etc/echo/credentials/shadowglass-v7-command/tyler-queue-id
ExecStart=/opt/shadowglass-v7-command/.venv/bin/python scheduler.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
InaccessiblePaths=/etc/echo/credentials/shadowglass-v7-command
